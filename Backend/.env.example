NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduhms_db?schema=public"

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=eduhms-attachments

# External Integrations
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=EduHMS
ARKESEL_API_URL=https://sms.arkesel.com/api/v2/sms/send
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
